rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Written only by Cloud Functions (admin SDK bypasses these rules).
    // Readable by any signed-in user because the leaderboard queries it.
    match /monthly_records/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /used_sessions/{id} {
      allow read, write: if false;
    }

    match /raffle_config/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Created by the draw function; the winner may only mark their own win claimed.
    match /raffle_winners/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']);
      allow create, delete: if false;
    }

    // Admin audit trail: written by Cloud Functions, read via adminListAudit.
    match /admin_audit/{id} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
